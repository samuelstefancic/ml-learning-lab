{
  "name": "ml-learning-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Interactive, reusable ML learning labs for ChatGPT and Codex via MCP Apps.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "playground": "tsx src/server.ts --playground",
    "playground:export": "tsx scripts/export-playground.ts",
    "start": "node dist/server.js",
    "start:stdio": "node dist/server.js --stdio",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "cors": "2.8.5",
    "express": "5.1.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.18.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
